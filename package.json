{
  "name": "dyon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck -w party",
    "test": "vitest run",
    "record": "tsx --conditions=react-server --env-file=.env.local scripts/record.ts",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "prepare": "husky",
    "worker": "tsx --conditions=react-server worker/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "@google-cloud/run": "^4.2.0",
    "@google-cloud/storage": "^9.0.0",
    "@openai/codex-sdk": "^0.169.1",
    "@pierre/diffs": "^1.6.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "partysocket": "^1.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "workspaces": [
    "party"
  ]
}
