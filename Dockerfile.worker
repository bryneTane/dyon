# The worker image: one Cloud Run Job execution runs one turn (worker/job.ts). Built from the repository root:
#   gcloud builds submit --config cloudbuild.yaml --project=<project>
# Kept small, because Cloud Run prepares the image before every turn: the worker is bundled into one file, and only
# the agents' packages are installed next to it.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY party/package.json party/
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY lib lib
COPY worker worker
RUN node_modules/.bin/esbuild worker/job.ts --bundle --platform=node --format=esm --target=node22 \
    --conditions=react-server --external:@anthropic-ai/claude-agent-sdk --external:@openai/codex-sdk \
    "--banner:js=import{createRequire as __dyonRequire}from'node:module';const require=__dyonRequire(import.meta.url);" \
    --outfile=dist/job.mjs \
  # The agents' packages at the versions of the lockfile.
  && node -e 'const l = require("./package-lock.json").packages; \
    const names = ["@anthropic-ai/claude-agent-sdk", "@openai/codex-sdk", "@openai/codex"]; \
    const dependencies = Object.fromEntries(names.map((n) => [n, l["node_modules/" + n].version])); \
    require("fs").writeFileSync("dist/package.json", JSON.stringify({ type: "module", dependencies }));'

FROM node:22-bookworm-slim
# git: workspaces and diffs. python3: agents commonly write and run Python. ca-certificates: HTTPS for the APIs.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/dist ./
RUN npm install --omit=dev --no-audit --no-fund \
  # npm cannot tell glibc from musl, so it installs both builds of each agent. This image is glibc (Debian).
  && rm -rf node_modules/@anthropic-ai/*-musl node_modules/@openai/*-musl \
  && du -sh node_modules

# Run folders in /work, outside /tmp: Codex's sandbox lets commands write anywhere in /tmp.
# The worker runs as an ordinary user: Claude Code refuses to skip permission prompts as root.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin dyon && mkdir /work && chown dyon /work
USER dyon
ENV NODE_ENV=production DYON_WORK_DIR=/work NODE_NO_WARNINGS=1
CMD ["node", "job.mjs"]
