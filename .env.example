# Copy this file to .env.local and fill in your keys. .env.local is never committed.

# Used by Claude Code (Claude Agent SDK). Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Used by Codex (Codex SDK). How to create one: https://help.openai.com/en/articles/4936850
OPENAI_API_KEY=

# Where Dyon keeps its database. Defaults to .dyon in this folder.
# DYON_DATA_DIR=

# Where agents work, one folder per run (default: the system temp folder, outside any git repository)
# DYON_WORK_DIR=
