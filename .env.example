# Copy this file to .env.local and fill in your keys. .env.local is never committed.

# Used by Claude Code (Claude Agent SDK). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Used by Codex (Codex SDK). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Where Dyon keeps its database and the agents' workspaces. Defaults to .dyon in this folder.
# DYON_DATA_DIR=
